# PostgreSQL (local install, no Docker)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/equipment_rental?schema=public"

PORT=3000
FRONTEND_URL="http://localhost:5173"

# LLM
#   mock              → deterministic scripted agent reasoning, no API key needed (offline demo / tests)
#   openai-compatible → any OpenAI-compatible endpoint. Free options:
#       Ollama (local): LLM_BASE_URL=http://localhost:11434/v1     LLM_MODEL=qwen2.5:3b   LLM_API_KEY=ollama
#       Groq (cloud):   LLM_BASE_URL=https://api.groq.com/openai/v1 LLM_MODEL=llama-3.3-70b-versatile
#       OpenRouter:     LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=<a ":free" model with tool support>
LLM_PROVIDER="openai-compatible"
LLM_BASE_URL="http://localhost:11434/v1"
LLM_API_KEY="ollama"
LLM_MODEL="qwen2.5:3b"
LLM_TIMEOUT_MS=120000
