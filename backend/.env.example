# PostgreSQL (local install, no Docker)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/equipment_rental?schema=public"

PORT=3000
FRONTEND_URL="http://localhost:5173"

# LLM
#   mock              → deterministic scripted agent reasoning, no API key needed (offline demo / tests)
#   openai-compatible → any OpenAI-compatible endpoint. Free options:
#       Ollama (local): LLM_BASE_URL=http://localhost:11434/v1     LLM_MODEL=qwen2.5:3b   LLM_API_KEY=ollama
#       Groq (cloud):   LLM_BASE_URL=https://api.groq.com/openai/v1 LLM_MODEL=llama-3.3-70b-versatile
#       OpenRouter:     LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=<a ":free" model with tool support>
LLM_PROVIDER="openai-compatible"
LLM_BASE_URL="http://localhost:11434/v1"
LLM_API_KEY="ollama"
LLM_MODEL="qwen2.5:3b"
LLM_TIMEOUT_MS=120000

# SMS gateway — "simulated" (default) or "mozesms" (https://api.mozesms.com)
SMS_PROVIDER="simulated"
MOZESMS_API_KEY=""
MOZESMS_API_SECRET=""
# SMS_ALLOWLIST="258841234567"   # optional: only these numbers receive real SMS

# M-Pesa — "simulated" (default) or "vodacom" (real charges, https://api.vm.co.mz:18352)
MPESA_PROVIDER="simulated"   # simulated | emedx | vodacom
EMEDX_CLIENT_KEY=""
EMEDX_CLIENT_SECRET=""
MPESA_API_KEY=""
MPESA_PUBLIC_KEY=""
MPESA_SERVICE_PROVIDER_CODE=""
MPESA_DEPOSIT_PERCENT=10
