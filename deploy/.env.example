# Copy to deploy/.env on the server. DATABASE_URL is built by docker-compose from POSTGRES_PASSWORD.
POSTGRES_PASSWORD=change-me
PORT=3000
FRONTEND_URL=https://rentops.mozweb.site
AUTH_SECRET=change-me-to-a-long-random-string
LLM_PROVIDER=mock
# Groq: LLM_PROVIDER=openai-compatible  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_API_KEY=gsk_...  LLM_MODEL=llama-3.3-70b-versatile
EMAIL_PROVIDER=simulated
# SMS (MozeSMS). simulated = nothing is sent. Each SMS costs credits (1.35 MZN on the basic plan).
SMS_PROVIDER=simulated
MOZESMS_API_KEY=
MOZESMS_API_SECRET=
# SMS_SENDER_ID=          # must be approved by MozeSMS; empty = "MozeSMS"
# SMS_ALLOWLIST=258841234567,258821234567   # optional: only these numbers receive real SMS
# M-Pesa (Vodacom Mozambique, C2B). simulated = no money moves. vodacom = real charges.
MPESA_PROVIDER=simulated
MPESA_API_KEY=
MPESA_PUBLIC_KEY=          # from developer.mpesa.vm.co.mz (base64, one line)
MPESA_SERVICE_PROVIDER_CODE=
MPESA_DEPOSIT_PERCENT=10
# MPESA_MAX_AMOUNT=0       # optional cap per transaction (MZN)
